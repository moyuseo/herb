generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Herb {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  aliases     String?
  source      String?
  origin      String?
  category    String
  properties  String?
  efficacy    String?
  usage       String?
  specGrade   String?
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quotes      PriceQuote[]
  supplies    SupplyDemand[]
  news        NewsArticle[]
}

model PriceQuote {
  id            Int      @id @default(autoincrement())
  herbId        Int
  herb          Herb     @relation(fields: [herbId], references: [id])
  price         Float
  change        Float
  changePercent Float
  origin        String?
  spec          String?
  date          DateTime
  createdAt     DateTime @default(now())
}

model NewsArticle {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String
  source      String?
  herbId      Int?
  herb        Herb?    @relation(fields: [herbId], references: [id])
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupplyDemand {
  id          Int      @id @default(autoincrement())
  type        String
  herbId      Int
  herb        Herb     @relation(fields: [herbId], references: [id])
  quantity    String
  price       String?
  origin      String?
  contact     String
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PriceIndex {
  id            Int      @id @default(autoincrement())
  name          String
  value         Float
  change        Float
  changePercent Float
  date          DateTime
  createdAt     DateTime @default(now())
}

model MarketAnalysis {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
